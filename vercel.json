{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "crossway-eta.vercel.app"
        }
      ],
      "destination": "https://crosswayhq.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blog/covers/:file",
      "destination": "/:file"
    },
    {
      "source": "/blog/:slug",
      "destination": "/:slug"
    },
    {
      "source": "/compare/:slug",
      "destination": "/:slug"
    }
  ]
}
