{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "crossway-eta.vercel.app"
        }
      ],
      "destination": "https://crosswayhq.com/:path*",
      "permanent": true
    },
    {
      "source": "/welcome",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/junction",
      "destination": "/app",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/c/:slug",
      "destination": "/company"
    },
    {
      "source": "/jobs",
      "destination": "/api/jobs"
    },
    {
      "source": "/jobs/:slug",
      "destination": "/api/jobs?slug=:slug"
    },
    {
      "source": "/sitemap-jobs.xml",
      "destination": "/api/jobs-sitemap"
    }
  ]
}
